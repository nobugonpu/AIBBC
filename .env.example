# Supabase (Phase 2a — replaced by SQLite + SQLCipher in Phase 2b)
#
# Get these from: Supabase Dashboard → Project Settings → API
#   VITE_SUPABASE_URL        : "Project URL"
#   VITE_SUPABASE_ANON_KEY   : "Project API keys" → "anon" "public"
#
# WARNING: NEVER use the "service_role" key here.
# The VITE_ prefix exposes the value to the client bundle. The anon key is
# designed for client-side use (RLS enforces access control). The service_role
# key bypasses RLS and would grant admin access to anyone running the app.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# OpenAI (used by the legacy Gallery/MediaUpload feature only — out of scope
# for AIBBC; will be removed in Phase 2c when AI calls move to the Express
# server with the Claude API).
# Leaving this empty is fine for Phase 2a — the app's main screens
# (PatientManager, TreatmentScheduler) do not call OpenAI.
VITE_OPENAI_API_KEY=
